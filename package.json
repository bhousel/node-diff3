{
  "name": "node-diff3",
  "version": "3.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhousel/node-diff3.git"
  },
  "description": "A JavaScript/TypeScript library for text diffing and three-way-merge.",
  "contributors": [
    "Bryan Housel <bhousel@gmail.com> (https://github.com/bhousel)"
  ],
  "keywords": [
    "diff",
    "diff3",
    "diffutils",
    "gnu",
    "javascript",
    "merge",
    "patch",
    "typescript"
  ],
  "files": [
    "dist/",
    "src/"
  ],
  "type": "module",
  "exports": {
    "types": "./dist/ts/diff3.d.ts",
    "bun": "./src/diff3.ts",
    "import": "./dist/js/diff3.mjs",
    "require": "./dist/js/diff3.mjs",
    "browser": "./dist/js/diff3.iife.js",
    "default": "./dist/js/diff3.mjs"
  },
  "scripts": {
    "all": "bun run --sequential clean check build test package",
    "clean": "bun ./scripts/clean.ts",
    "build": "bun run --parallel 'build:*'",
    "build:js": "bun ./scripts/build_js.ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "check": "bun run --parallel 'check:*'",
    "check:lint": "oxlint ./scripts ./src ./test",
    "check:types": "tsc --noEmit",
    "package": "bun run --sequential package:pack package:publint package:attw",
    "package:pack": "bun pm pack --quiet --ignore-scripts --destination ./build",
    "package:publint": "publint --level warning ./build/*.tgz",
    "package:attw": "attw --profile esm-only --no-summary ./build/*.tgz",
    "test": "bun test --dots --coverage ./test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.4.4",
    "oxlint": "^1.92.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  }
}
